{
  "headers": [
    {
      "source": "/assets/(.*-(?:96|280|320|380|400|480|560|640|720|760|960|1100).*|inter-latin\\.woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
